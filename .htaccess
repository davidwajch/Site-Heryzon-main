Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Páginas antigas: a política nova fica em /privacidade/; termos e cookies deixaram de existir.
RewriteRule ^(privacidade|termos|cookies)\.html$ /privacidade/ [R=301,L]

# Código-fonte e arquivos de trabalho não são servidos.
RewriteRule ^(src|tests|docs|node_modules)(/|$) - [F,L]
RewriteRule ^(README\.md|package\.json|\.git.*)$ - [F,L]
</IfModule>

AddType font/woff2 .woff2

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType audio/mpeg "access plus 1 month"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/javascript "access plus 1 year"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>
